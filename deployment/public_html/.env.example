# WROP Interior Environment Configuration

# Database Configuration (Hostinger MySQL)
# For Hostinger: Create a MySQL database and user in hPanel -> Databases -> MySQL Databases
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_wrop
DB_USER=u123456789_wropuser
DB_PASS=YourSecureDatabasePassword123!

# For local development with zero setup, set:
# DB_DRIVER=sqlite

# Site URL
SITE_URL=https://wropinterior.com

# System Environment
APP_ENV=production
